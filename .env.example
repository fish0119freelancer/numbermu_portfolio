# Required for /admin writes. Use a long random value.
ADMIN_API_TOKEN=

# GitHub token with Contents: Read and write access to this repository.
# The existing GIT_PUSH_TOKEN remains supported for backward compatibility.
GITHUB_TOKEN=
GITHUB_REPOSITORY=fish0119freelancer/numbermu_portfolio
GITHUB_BRANCH=main

# Optional. If omitted, rely on Render's branch auto-deploy.
RENDER_DEPLOY_HOOK_URL=

# Public metadata.
NEXT_PUBLIC_SITE_URL=https://numbermu-portfolio.onrender.com
